
@page "/threads"
@rendermode InteractiveServer
@implements IDisposable

@using CampusChat.Models
@using CampusChat.Services
@using DiscussionThread = CampusChat.Models.Thread

@inject ThreadService ThreadService
@inject UserStateService UserState
@inject ChangeNotifier Notifier

<PageTitle>Discussion Threads - CampusChat</PageTitle>

<h2>Discussion Threads</h2>
<p class="text-muted">Explore discussions or create a new thread.</p>

@if (!UserState.IsSignedIn)
{
    <div class="alert alert-info">
        Please <a href="/signin">select a user</a> first.
    </div>
}
else
{
    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert alert-danger">@message</div>
    }

    <div class="card mb-4">
        <div class="card-body">
            <h5>Create a Thread</h5>

            <div class="mb-3">
                <label class="form-label">Title</label>
                <input class="form-control" @bind="title" maxlength="100" />
            </div>

            <div class="mb-3">
                <label class="form-label">Description</label>
                <textarea class="form-control" @bind="description"></textarea>
            </div>

            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox"
                       id="privateThread" @bind="isPrivate" />
                <label class="form-check-label" for="privateThread">
                    Private thread
                </label>
            </div>

            @if (isPrivate)
            {
                <div class="mb-3">
                    <label class="form-label">Access Code</label>
                    <input class="form-control" type="password"
                           @bind="accessCode" />
                </div>
            }

            <button class="btn btn-primary" @onclick="CreateThread">
                Create Thread
            </button>
        </div>
    </div>
}

<div class="mb-3">
    <input class="form-control"
           placeholder="Search threads..."
           @bind="searchText"
           @bind:event="oninput" />
</div>

@if (FilteredThreads.Count == 0)
{
    <div class="alert alert-secondary">
        No discussion threads found.
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var thread in FilteredThreads)
        {
            <div class="col-md-6" @key="thread.Id">
                <div class="card h-100">
                    <div class="card-body">
                        <h5>@thread.Title</h5>

                        <span class="badge @(thread.IsPrivate
                            ? "bg-warning text-dark"
                            : "bg-success")">
                            @(thread.IsPrivate ? "Private" : "Public")
                        </span>

                        <p class="mt-3">@thread.Description</p>

                        <small class="text-muted">
                            @thread.MemberUserIds.Count member(s)
                        </small>

                        <div class="mt-3">
                            <a class="btn btn-outline-primary btn-sm"
                               href="@($"/threads/{thread.Id}")">
                                Open Thread
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private string title = "";
    private string description = "";
    private string accessCode = "";
    private string searchText = "";
    private string? message;
    private bool isPrivate;

    private List<DiscussionThread> threads = new();

    private List<DiscussionThread> FilteredThreads =>
        threads.Where(t =>
            t.Title.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
            t.Description.Contains(searchText, StringComparison.OrdinalIgnoreCase))
            .ToList();

    protected override void OnInitialized()
    {
        threads = ThreadService.GetThreads();
        Notifier.OnChange += RefreshThreads;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await UserState.RestoreSessionAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    private void CreateThread()
    {
        try
        {
            message = null;

            ThreadService.CreateThread(
                UserState.CurrentUserId!.Value,
                title,
                description,
                isPrivate,
                accessCode);

            title = "";
            description = "";
            accessCode = "";
            isPrivate = false;
        }
        catch (Exception ex) when (
            ex is ArgumentException ||
            ex is UnauthorizedAccessException ||
            ex is KeyNotFoundException)
        {
            message = ex.Message;
        }
    }

    private void RefreshThreads()
    {
        _ = InvokeAsync(() =>
        {
            threads = ThreadService.GetThreads();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        Notifier.OnChange -= RefreshThreads;
    }
}
