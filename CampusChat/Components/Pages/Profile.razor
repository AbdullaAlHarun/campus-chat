
@page "/profile"
@rendermode InteractiveServer
@implements IDisposable

@using CampusChat.Models
@using CampusChat.Services
@using DiscussionThread = CampusChat.Models.Thread

@inject UserService UserService
@inject UserStateService UserState
@inject ThreadService ThreadService
@inject ChangeNotifier Notifier

<PageTitle>My Profile - CampusChat</PageTitle>

<h2>My Profile</h2>
<p class="text-muted">View and update your profile information.</p>

@if (!UserState.IsSignedIn)
{
    <div class="alert alert-info">
        Please <a href="/signin">select a user</a> first.
    </div>
}
else if (user == null)
{
    <div class="alert alert-warning">
        Profile not found.
    </div>
}
else
{
    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success">@successMessage</div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <div class="card mb-4">
        <div class="card-body">
            <div class="d-flex align-items-center gap-3 mb-4">
                <div style="@($"width:65px;height:65px;border-radius:50%;background-color:{user.AvatarColor};")">
                </div>

                <div>
                    <h4 class="mb-1">@user.DisplayName</h4>
                    <span class="text-muted">
                        @(user.IsAuditor ? "Auditor" : $"Study Year {user.StudyYear}")
                    </span>
                </div>
            </div>

            <h5>Edit Profile</h5>

            <div class="mb-3">
                <label class="form-label">Display Name</label>
                <input class="form-control" @bind="displayName" />
            </div>

            <div class="mb-3">
                <label class="form-label">Bio</label>
                <textarea class="form-control"
                          rows="3"
                          @bind="bio"></textarea>
            </div>

            <div class="mb-3">
                <label class="form-label">Avatar Color</label>
                <input type="color"
                       class="form-control form-control-color"
                       @bind="avatarColor" />
            </div>

            @if (!user.IsAuditor)
            {
                <div class="mb-3">
                    <label class="form-label">Study Year</label>
                    <input type="number"
                           min="1"
                           max="5"
                           class="form-control"
                           @bind="studyYear" />
                </div>
            }

            <button class="btn btn-primary" @onclick="SaveProfile">
                Save Changes
            </button>
        </div>
    </div>

    <h4>My Joined Threads</h4>

    @if (joinedThreads.Count == 0)
    {
        <div class="alert alert-secondary">
            You haven't joined any discussions yet.
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var thread in joinedThreads)
            {
                <div class="col-md-6" @key="thread.Id">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5>@thread.Title</h5>

                            <span class="badge @(thread.IsPrivate
                                ? "bg-warning text-dark"
                                : "bg-success")">
                                @(thread.IsPrivate ? "Private" : "Public")
                            </span>

                            <p class="mt-3">@thread.Description</p>

                            <a class="btn btn-outline-primary btn-sm"
                               href="@($"/threads/{thread.Id}")">
                                Open Thread
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}

@code {
    private User? user;
    private List<DiscussionThread> joinedThreads = new();

    private string displayName = "";
    private string bio = "";
    private string avatarColor = "#3B82F6";
    private int studyYear = 1;

    private string? successMessage;
    private string? errorMessage;

    protected override void OnInitialized()
    {
        UserState.OnChange += HandleChange;
        Notifier.OnChange += HandleChange;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await UserState.RestoreSessionAsync();
            LoadProfile();
            await InvokeAsync(StateHasChanged);
        }
    }

    private void LoadProfile()
    {
        if (!UserState.CurrentUserId.HasValue)
        {
            user = null;
            joinedThreads.Clear();
            return;
        }

        int userId = UserState.CurrentUserId.Value;

        user = UserService.GetUserById(userId);
        joinedThreads = ThreadService.GetJoinedThreads(userId);

        if (user == null)
            return;

        displayName = user.DisplayName;
        bio = user.Bio;
        avatarColor = user.AvatarColor;
        studyYear = user.StudyYear;
    }

    private void SaveProfile()
    {
        if (user == null || !UserState.CurrentUserId.HasValue)
            return;

        try
        {
            errorMessage = null;
            successMessage = null;

            int userId = UserState.CurrentUserId.Value;

            UserService.UpdateProfile(
                userId,
                userId,
                displayName,
                bio,
                avatarColor,
                user.IsAuditor ? user.StudyYear : studyYear);

            LoadProfile();
            successMessage = "Profile updated successfully.";
        }
        catch (Exception ex) when (
            ex is ArgumentException ||
            ex is UnauthorizedAccessException ||
            ex is KeyNotFoundException)
        {
            errorMessage = ex.Message;
        }
    }

    private void HandleChange()
    {
        _ = InvokeAsync(() =>
        {
            LoadProfile();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        UserState.OnChange -= HandleChange;
        Notifier.OnChange -= HandleChange;
    }
}
