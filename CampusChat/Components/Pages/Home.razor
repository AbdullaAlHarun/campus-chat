
@page "/"
@rendermode InteractiveServer
@inject CampusChat.Services.UserStateService UserState
@inject CampusChat.Services.UserService UserService
@inject CampusChat.Services.ThreadService ThreadService
@inject CampusChat.Services.DirectChatService ChatService
@inject NavigationManager Navigation

<PageTitle>Dashboard - CampusChat</PageTitle>

@if (!UserState.IsSignedIn)
{
    <h2>Welcome to CampusChat</h2>
    <p>Connect with other students through discussions and direct messages.</p>

    <a class="btn btn-primary" href="/signin">Select a User</a>
}
else
{
    var user = UserService.GetUserById(UserState.CurrentUserId!.Value);

    <h2>Welcome back, @user?.DisplayName!</h2>
    <p class="text-muted">Your CampusChat dashboard</p>

    <div class="row g-3 mt-2">
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5>Discussion Threads</h5>
                    <h2>@ThreadService.GetThreads().Count</h2>
                    <a href="/threads">Browse Threads →</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5>My Threads</h5>
                    <h2>@ThreadService.GetJoinedThreads(user!.Id).Count</h2>
                    <a href="/my-threads">View My Threads →</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5>Direct Chats</h5>
                    <h2>@ChatService.GetChats(user!.Id).Count</h2>
                    <a href="/chats">View Chats →</a>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <h4>Quick Actions</h4>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-primary" href="/threads">
                Explore Threads
            </a>
            <a class="btn btn-outline-primary" href="/profile">
                My Profile
            </a>
            <button class="btn btn-outline-danger"
                    @onclick="SignOut">
                Sign Out
            </button>
        </div>
    </div>
}

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await UserState.RestoreSessionAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SignOut()
    {
        await UserState.SignOutAsync();
        Navigation.NavigateTo("/signin");
    }
}
